// Jendela utama DANload (Fase 3: unduh YouTube MP4/MP3, Pengaturan, wizard setup).
//
// Tata letak mengikuti CLAUDE.md Bagian 2.7:
//   bar atas  : nama aplikasi, kolom cari, pilihan platform
//   kiri      : sidebar navigasi
//   tengah    : daftar (unduhan / pustaka / antrean) atau pengaturan
//   kanan     : form "Unduh baru"
//   bawah     : status bar
//
// Catatan performa: tidak ada animasi atau timer di sini, jadi saat diam
// Slint tidak menggambar ulang apa pun (CPU idle mendekati 0%).

import { Theme, Icons } from "theme.slint";
import {
    Icon, Panel, NavButton, Chip, PlatformBadge, InputField,
    PrimaryButton, GhostButton, Segmented, FieldLabel, ValueRow, Dropdown
} from "components.slint";
import { DownloadList, DownloadItem, DownloadState } from "downloads.slint";
import { SettingsPage, ComponentInfo, ComponentState } from "settings-page.slint";
import { SetupWizard, WizardState } from "setup-wizard.slint";

// Hasil pengecekan URL terhadap platform yang dipilih. Dihitung di Rust (src/platform.rs).
export struct UrlFeedback {
    // `true` jika URL berasal dari platform yang dipilih dan boleh diunduh.
    valid: bool,
    // Pesan di bawah kolom URL (kosong = tidak ada pesan).
    message: string,
}

// Diekspor supaya tipe ini bisa dipakai dari Rust (src/app.rs).
export { ComponentInfo, ComponentState, WizardState, DownloadItem, DownloadState }

export component AppWindow inherits Window {
    // Diisi dari Rust (src/main.rs) memakai versi di Cargo.toml.
    in property <string> app-version: "0.0.0";

    // Halaman aktif: 0 = Unduh, 1 = Pustaka, 2 = Antrean, 3 = Pengaturan.
    in-out property <int> current-page: 0;
    // Filter aktif pada daftar: indeks ke `filters`.
    in-out property <int> current-filter: 0;
    // Mode unduh: 0 = Video, 1 = Audio.
    in-out property <int> download-mode: 0;
    // Platform sumber yang dipilih pengguna: indeks ke `platforms`. Bawaan: YouTube.
    in-out property <int> platform: 0;
    // URL yang diketik atau ditempel pengguna.
    in-out property <string> url <=> url-field.text;

    // ----- Diisi dari Rust (src/app.rs) -----
    // Status tiap komponen (yt-dlp, FFmpeg, ffprobe).
    in property <[ComponentInfo]> components;
    // `true` selama pemeriksaan komponen masih berjalan.
    in property <bool> checking-components;
    // `true` jika semua komponen siap dipakai.
    in property <bool> components-ready;
    // Folder tujuan unduhan yang sedang berlaku.
    in property <string> download-folder;
    // Pesan masalah untuk status bar (kosong = tidak ada masalah).
    in property <string> notice;
    // Simpan video dan audio di subfolder terpisah.
    in-out property <bool> separate-subfolders;

    // ----- Ditangani di Rust (src/app.rs) -----
    callback recheck-components();
    callback choose-download-folder();
    callback download-mode-changed(index: int);
    callback subfolders-toggled(checked: bool);
    // Mengecek apakah `url` berasal dari platform berindeks `platform`.
    // `pure`: hanya menghitung, tidak mengubah apa pun, jadi aman dipakai di binding.
    pure callback check-url(platform: int, url: string) -> UrlFeedback;

    // Dihitung ulang otomatis setiap kali platform atau URL berubah.
    property <UrlFeedback> url-feedback: root.check-url(root.platform, root.url);

    // ----- Unduhan -----
    // Daftar unduhan sesi ini, terbaru di atas. Diisi dari Rust.
    in property <[DownloadItem]> downloads;
    // `true` selama ada unduhan berjalan (Fase 3: satu unduhan sekaligus).
    in property <bool> downloading;
    // Pilihan resolusi dan bitrate (labelnya dari Rust, src/formats.rs).
    in property <[string]> video-quality-options;
    in property <[string]> audio-bitrate-options;
    in-out property <int> video-quality-index;
    in-out property <int> audio-bitrate-index;
    callback start-download();
    callback cancel-download(id: int);
    callback retry-download(id: int);
    callback show-in-folder(id: int);
    callback video-quality-changed(index: int);
    callback audio-bitrate-changed(index: int);

    // Tombol Unduh aktif hanya jika komponen lengkap, link cocok dengan platform
    // (dan platformnya sudah didukung, dicek di Rust), dan tidak ada unduhan berjalan.
    property <bool> can-download: root.components-ready && root.url-feedback.valid && !root.downloading;
    // Alasan tombol Unduh belum aktif (kosong jika tidak perlu penjelasan).
    property <string> download-hint: root.downloading ? "Tunggu unduhan yang sedang berjalan selesai." : root.checking-components ? "Memeriksa komponen..." : !root.components-ready ? "Komponen belum lengkap. Buka Pengaturan untuk memasangnya." : root.url == "" ? "Tempel link " + root.platforms[root.platform].name + " untuk mulai." : "";

    property <[{ title: string, empty-title: string, empty-hint: string, icon: string }]> pages: [
        {
            title: "Unduhan",
            empty-title: "Belum ada unduhan",
            empty-hint: "Tempel URL di panel kanan untuk mulai mengunduh.",
            icon: Icons.download,
        },
        {
            title: "Pustaka",
            empty-title: "Pustaka masih kosong",
            empty-hint: "File yang sudah diunduh akan muncul di sini.",
            icon: Icons.library,
        },
        {
            title: "Antrean",
            empty-title: "Antrean kosong",
            empty-hint: "Unduhan yang sedang menunggu giliran akan muncul di sini.",
            icon: Icons.queue,
        },
        {
            title: "Pengaturan",
            empty-title: "",
            empty-hint: "",
            icon: Icons.settings,
        },
    ];
    property <[string]> filters: ["Semua", "Video", "Audio", "YouTube", "Facebook", "Instagram"];
    property <[{ name: string, url-hint: string }]> platforms: [
        { name: "YouTube", url-hint: "https://www.youtube.com/watch?v=..." },
        { name: "Facebook", url-hint: "https://www.facebook.com/..." },
        { name: "Instagram", url-hint: "https://www.instagram.com/reel/..." },
    ];

    title: "DANload";
    icon: @image-url("../assets/icon.png");
    background: Theme.background;
    default-font-size: 13px;
    preferred-width: 1120px;
    preferred-height: 700px;
    min-width: 920px;
    min-height: 580px;

    VerticalLayout {
        padding: Theme.gap;
        spacing: Theme.gap;

        // ---------- Bar atas ----------
        HorizontalLayout {
            height: 40px;
            spacing: Theme.gap;

            // Nama aplikasi
            HorizontalLayout {
                width: 150px;
                padding-left: 6px;
                spacing: 9px;

                VerticalLayout {
                    alignment: center;
                    Rectangle {
                        width: 8px;
                        height: 8px;
                        border-radius: 4px;
                        background: Theme.accent;
                    }
                }

                Text {
                    text: "DANload";
                    font-size: 16px;
                    font-weight: 700;
                    color: Theme.text;
                    vertical-alignment: center;
                }
            }

            // Kolom cari (akan mencari di Pustaka mulai Fase 6)
            InputField {
                horizontal-stretch: 1;
                height: 40px;
                border-radius: 20px;
                icon: Icons.search;
                placeholder: "Cari file unduhan...";
            }

            // Pilihan platform sumber unduhan
            Rectangle {
                horizontal-stretch: 0;
                height: 40px;
                border-radius: 20px;
                background: Theme.panel;

                HorizontalLayout {
                    padding: 5px;
                    spacing: 2px;
                    for item[index] in root.platforms: PlatformBadge {
                        text: item.name;
                        active: root.platform == index;
                        clicked => {
                            root.platform = index;
                        }
                    }
                }
            }
        }

        // ---------- Bagian tengah: sidebar | daftar | panel kanan ----------
        HorizontalLayout {
            vertical-stretch: 1;
            spacing: Theme.gap;

            // Sidebar
            Panel {
                width: 76px;

                VerticalLayout {
                    padding: 8px;
                    spacing: 6px;
                    alignment: start;

                    NavButton {
                        icon: Icons.download;
                        label: "Unduh";
                        active: root.current-page == 0;
                        clicked => {
                            root.current-page = 0;
                        }
                    }

                    NavButton {
                        icon: Icons.library;
                        label: "Pustaka";
                        active: root.current-page == 1;
                        clicked => {
                            root.current-page = 1;
                        }
                    }

                    NavButton {
                        icon: Icons.queue;
                        label: "Antrean";
                        active: root.current-page == 2;
                        clicked => {
                            root.current-page = 2;
                        }
                    }

                    Rectangle {
                        height: 1px;
                        background: Theme.border;
                    }

                    NavButton {
                        icon: Icons.settings;
                        label: "Pengaturan";
                        active: root.current-page == 3;
                        alert: !root.checking-components && !root.components-ready;
                        clicked => {
                            root.current-page = 3;
                        }
                    }
                }
            }

            // Area tengah
            Panel {
                horizontal-stretch: 1;

                VerticalLayout {
                    padding: 20px;
                    spacing: 16px;

                    Text {
                        text: root.pages[root.current-page].title;
                        font-size: 20px;
                        font-weight: 700;
                        color: Theme.text;
                    }

                    // Chip filter: hanya untuk halaman berisi daftar file.
                    if root.current-page != 3: HorizontalLayout {
                        alignment: start;
                        spacing: 8px;
                        for filter[index] in root.filters: Chip {
                            text: filter;
                            selected: root.current-filter == index;
                            clicked => {
                                root.current-filter = index;
                            }
                        }
                    }

                    // Halaman Unduhan: daftar kartu unduhan sesi ini.
                    if root.current-page == 0 && root.downloads.length > 0: DownloadList {
                        vertical-stretch: 1;
                        items: root.downloads;
                        busy: root.downloading;
                        cancel(id) => {
                            root.cancel-download(id);
                        }
                        retry(id) => {
                            root.retry-download(id);
                        }
                        show-in-folder(id) => {
                            root.show-in-folder(id);
                        }
                    }

                    if root.current-page == 3: SettingsPage {
                        vertical-stretch: 1;
                        components: root.components;
                        checking: root.checking-components;
                        ready: root.components-ready;
                        download-folder: root.download-folder;
                        separate-subfolders <=> root.separate-subfolders;
                        recheck-components => {
                            root.recheck-components();
                        }
                        choose-download-folder => {
                            root.choose-download-folder();
                        }
                        open-setup => {
                            WizardState.step = 1;
                            WizardState.visible = true;
                        }
                        subfolders-toggled(checked) => {
                            root.subfolders-toggled(checked);
                        }
                    }

                    // Keadaan kosong (belum ada data)
                    if root.current-page != 3 && !(root.current-page == 0 && root.downloads.length > 0): Rectangle {
                        vertical-stretch: 1;

                        VerticalLayout {
                            alignment: center;
                            spacing: 10px;

                            HorizontalLayout {
                                alignment: center;
                                Rectangle {
                                    width: 56px;
                                    height: 56px;
                                    border-radius: 28px;
                                    background: Theme.panel-raised;
                                    Icon {
                                        width: 24px;
                                        height: 24px;
                                        commands: root.pages[root.current-page].icon;
                                    }
                                }
                            }

                            Text {
                                text: root.pages[root.current-page].empty-title;
                                font-size: 15px;
                                font-weight: 600;
                                color: Theme.text;
                                horizontal-alignment: center;
                            }

                            Text {
                                text: root.pages[root.current-page].empty-hint;
                                color: Theme.text-muted;
                                horizontal-alignment: center;
                                wrap: word-wrap;
                            }
                        }
                    }
                }
            }

            // Panel kanan: form unduh baru
            Panel {
                width: 320px;

                VerticalLayout {
                    padding: 20px;
                    spacing: 14px;
                    alignment: start;

                    Text {
                        text: "Unduh baru";
                        font-size: 16px;
                        font-weight: 700;
                        color: Theme.text;
                    }

                    VerticalLayout {
                        spacing: 6px;
                        FieldLabel {
                            text: root.platform == 0 ? "URL YOUTUBE" : root.platform == 1 ? "URL FACEBOOK" : "URL INSTAGRAM";
                        }

                        HorizontalLayout {
                            spacing: 8px;
                            url-field := InputField {
                                horizontal-stretch: 1;
                                icon: Icons.link;
                                placeholder: root.platforms[root.platform].url-hint;
                            }

                            GhostButton {
                                text: "Tempel";
                                clicked => {
                                    url-field.paste-from-clipboard();
                                }
                            }
                        }

                        if root.url-feedback.message != "": Text {
                            text: root.url-feedback.message;
                            font-size: 11px;
                            color: root.url-feedback.valid ? Theme.ok : Theme.warning;
                            wrap: word-wrap;
                        }
                    }

                    VerticalLayout {
                        spacing: 6px;
                        FieldLabel {
                            text: "MODE";
                        }

                        Segmented {
                            first: "Video";
                            second: "Audio";
                            selected-index <=> root.download-mode;
                            selected(index) => {
                                root.download-mode-changed(index);
                            }
                        }
                    }

                    HorizontalLayout {
                        spacing: 8px;

                        VerticalLayout {
                            width: (parent.width - 8px) / 2;
                            spacing: 6px;
                            FieldLabel {
                                text: "FORMAT";
                            }

                            ValueRow {
                                text: root.download-mode == 0 ? "MP4" : "MP3";
                            }
                        }

                        VerticalLayout {
                            spacing: 6px;
                            FieldLabel {
                                text: root.download-mode == 0 ? "RESOLUSI MAKS." : "BITRATE";
                            }

                            Dropdown {
                                options: root.download-mode == 0 ? root.video-quality-options : root.audio-bitrate-options;
                                current-index: root.download-mode == 0 ? root.video-quality-index : root.audio-bitrate-index;
                                selected(index) => {
                                    if root.download-mode == 0 {
                                        root.video-quality-index = index;
                                        root.video-quality-changed(index);
                                    } else {
                                        root.audio-bitrate-index = index;
                                        root.audio-bitrate-changed(index);
                                    }
                                }
                            }
                        }
                    }

                    VerticalLayout {
                        spacing: 6px;
                        FieldLabel {
                            text: "SIMPAN KE";
                        }

                        ValueRow {
                            icon: Icons.folder;
                            text: root.download-folder;
                            clickable: true;
                            clicked => {
                                root.choose-download-folder();
                            }
                        }
                    }

                    Rectangle {
                        height: 1px;
                        background: Theme.border;
                    }

                    PrimaryButton {
                        text: root.downloading ? "Sedang mengunduh..." : "Unduh";
                        enabled: root.can-download;
                        clicked => {
                            root.start-download();
                        }
                    }

                    if root.download-hint != "": Text {
                        text: root.download-hint;
                        font-size: 11px;
                        color: Theme.text-dim;
                        wrap: word-wrap;
                    }
                }
            }
        }

        // ---------- Status bar ----------
        HorizontalLayout {
            height: 20px;
            padding-left: 6px;
            padding-right: 6px;
            spacing: 14px;

            Text {
                horizontal-stretch: 1;
                text: root.notice != "" ? root.notice : root.checking-components ? "Memeriksa komponen..." : root.components-ready ? "Siap." : "Komponen belum lengkap. Buka Pengaturan untuk melihat detailnya.";
                font-size: 12px;
                color: root.notice != "" ? Theme.error : root.checking-components || root.components-ready ? Theme.text-muted : Theme.warning;
                vertical-alignment: center;
                overflow: elide;
            }

            Text {
                text: root.downloading ? "1 unduhan berjalan" : "Tidak ada unduhan aktif";
                font-size: 12px;
                color: root.downloading ? Theme.info : Theme.text-dim;
                vertical-alignment: center;
            }

            Text {
                text: "v" + root.app-version;
                font-size: 12px;
                color: Theme.text-dim;
                vertical-alignment: center;
            }
        }
    }

    // Wizard setup: lapisan di atas seluruh jendela.
    if WizardState.visible: SetupWizard {
        width: 100%;
        height: 100%;
        components: root.components;
        checking: root.checking-components;
        ready: root.components-ready;
        download-folder: root.download-folder;
        separate-subfolders <=> root.separate-subfolders;
        choose-download-folder => {
            root.choose-download-folder();
        }
        subfolders-toggled(checked) => {
            root.subfolders-toggled(checked);
        }
    }
}
