// Daftar unduhan di halaman "Unduhan": satu kartu per unduhan pada sesi ini.
// Hanya tampilan. Datanya diisi dan diperbarui dari Rust (src/app.rs).
// Riwayat permanen (tetap ada setelah aplikasi ditutup) menyusul di Pustaka, Fase 6.

import { Theme, Icons } from "theme.slint";
import { Icon, GhostButton, ProgressBar } from "components.slint";
import { ScrollView } from "std-widgets.slint";

// Keadaan satu unduhan.
export enum DownloadState {
    preparing, // menjalankan yt-dlp dan mengambil info video
    downloading, // sedang mengunduh
    processing, // menggabungkan/mengubah format dengan FFmpeg
    done, // selesai
    failed, // gagal
    cancelled, // dibatalkan pengguna
}

// Data satu kartu unduhan.
export struct DownloadItem {
    id: int,
    title: string,
    // mis. "YouTube · MP4 · 1080p"
    subtitle: string,
    state: DownloadState,
    // Kemajuan 0..1
    progress: float,
    // Teks status: kemajuan, pesan error, atau nama file hasil.
    detail: string,
}

// Ikon bulat sesuai keadaan.
component StateIcon inherits Rectangle {
    in property <DownloadState> state;
    property <color> tint: root.state == DownloadState.done ? Theme.ok : root.state == DownloadState.failed ? Theme.error : root.state == DownloadState.cancelled ? Theme.text-dim : Theme.info;

    width: 36px;
    height: 36px;
    border-radius: 18px;
    background: root.tint.with-alpha(0.14);

    Icon {
        width: 18px;
        height: 18px;
        commands: root.state == DownloadState.done ? Icons.check : root.state == DownloadState.failed || root.state == DownloadState.cancelled ? Icons.close : Icons.download;
        tint: root.tint;
    }
}

component DownloadCard inherits Rectangle {
    in property <DownloadItem> item;
    // `false` saat ada unduhan lain berjalan (hanya satu unduhan sekaligus).
    in property <bool> can-retry: true;
    callback cancel();
    callback retry();
    callback show-in-folder();

    property <bool> active: root.item.state == DownloadState.preparing || root.item.state == DownloadState.downloading || root.item.state == DownloadState.processing;

    border-radius: Theme.radius-small;
    border-width: 1px;
    border-color: Theme.border;
    background: Theme.field;

    HorizontalLayout {
        padding: 14px;
        spacing: 12px;

        VerticalLayout {
            alignment: start;
            StateIcon {
                state: root.item.state;
            }
        }

        VerticalLayout {
            horizontal-stretch: 1;
            spacing: 4px;

            Text {
                text: root.item.title;
                font-size: 14px;
                font-weight: 600;
                color: Theme.text;
                overflow: elide;
            }

            Text {
                text: root.item.subtitle;
                font-size: 11px;
                color: Theme.text-dim;
                overflow: elide;
            }

            if root.active: Rectangle {
                height: 4px;
            }

            if root.active: ProgressBar {
                value: root.item.state == DownloadState.processing ? 1.0 : root.item.progress;
            }

            Text {
                text: root.item.detail;
                font-size: 12px;
                color: root.item.state == DownloadState.failed ? Theme.error : root.item.state == DownloadState.done ? Theme.ok : Theme.text-muted;
                wrap: word-wrap;
            }
        }

        VerticalLayout {
            alignment: center;

            if root.active: GhostButton {
                text: "Batal";
                clicked => {
                    root.cancel();
                }
            }

            if root.item.state == DownloadState.done: GhostButton {
                text: "Tampilkan di folder";
                clicked => {
                    root.show-in-folder();
                }
            }

            if root.item.state == DownloadState.failed || root.item.state == DownloadState.cancelled: GhostButton {
                text: "Coba lagi";
                enabled: root.can-retry;
                clicked => {
                    root.retry();
                }
            }
        }
    }
}

export component DownloadList inherits ScrollView {
    in property <[DownloadItem]> items;
    // `true` saat ada unduhan berjalan.
    in property <bool> busy;
    callback cancel(id: int);
    callback retry(id: int);
    callback show-in-folder(id: int);

    VerticalLayout {
        alignment: start;
        spacing: 10px;
        padding-right: 14px;

        for item in root.items: DownloadCard {
            item: item;
            can-retry: !root.busy;
            cancel => {
                root.cancel(item.id);
            }
            retry => {
                root.retry(item.id);
            }
            show-in-folder => {
                root.show-in-folder(item.id);
            }
        }
    }
}
