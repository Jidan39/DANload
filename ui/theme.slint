// Tema DANload: semua warna dan ukuran dasar dikumpulkan di sini,
// supaya tampilan konsisten dan mudah diubah dari satu tempat.
// Acuan gaya: CLAUDE.md Bagian 2.7 (tema gelap, sudut membulat).

export global Theme {
    // Latar
    out property <color> background: #0d0e11;
    out property <color> panel: #16171b;
    out property <color> panel-raised: #212329;
    out property <color> field: #0f1013;
    out property <color> hover: #1b1c21;
    out property <color> border: #2a2c33;

    // Teks
    out property <color> text: #f1f1f2;
    out property <color> text-muted: #a0a2ab;
    out property <color> text-dim: #6b6e78;

    // Aksen (tombol utama) dan warna status
    out property <color> accent: #e8e5de;
    out property <color> accent-text: #121316;
    out property <color> ok: #4ccb82;
    out property <color> error: #f0605a;
    out property <color> warning: #e6b450;
    out property <color> info: #5aa9f0;

    // Ukuran
    out property <length> radius: 16px;
    out property <length> radius-small: 10px;
    out property <length> gap: 12px;
}

// Bentuk ikon garis (viewbox 24x24), dipakai oleh komponen `Icon`.
export global Icons {
    out property <string> download: "M12 4 V15 M7 10 L12 15 L17 10 M5 19 H19";
    out property <string> library: "M5 5 H10 V10 H5 Z M14 5 H19 V10 H14 Z M5 14 H10 V19 H5 Z M14 14 H19 V19 H14 Z";
    out property <string> queue: "M5 7 H19 M5 12 H19 M5 17 H13";
    out property <string> settings: "M4 8 H13 M18 8 H20 M13 6 H18 V10 H13 Z M4 16 H6 M11 16 H20 M6 14 H11 V18 H6 Z";
    out property <string> search: "M4 11 A7 7 0 1 0 18 11 A7 7 0 1 0 4 11 M16.5 16.5 L20 20";
    out property <string> folder: "M4 7 H10 L12 9 H20 V18 H4 Z";
    out property <string> check: "M5 12.5 L10 17 L19 7";
    out property <string> close: "M7 7 L17 17 M17 7 L7 17";
    out property <string> chevron-down: "M7 10 L12 15 L17 10";
    out property <string> link: "M9 15 L15 9 M11 6.5 L12.5 5 A4.6 4.6 0 0 1 19 11.5 L17.5 13 M13 17.5 L11.5 19 A4.6 4.6 0 0 1 5 12.5 L6.5 11";
    // Pustaka: jenis file (dipakai jika tidak ada thumbnail) dan peringatan.
    out property <string> video: "M4 7 H15 V17 H4 Z M15 10.5 L20 7.5 V16.5 L15 13.5";
    out property <string> audio: "M9 17 A2.5 2.5 0 1 1 4 17 A2.5 2.5 0 1 1 9 17 M9 17 V6 L19 4 V15 M19 15 A2.5 2.5 0 1 1 14 15 A2.5 2.5 0 1 1 19 15";
